# 复制为 .env 后按需修改，docker compose 会自动读取

# WebUI 密码，设置后启用 WebUI。请用足够长的随机字符串，例如 openssl rand -base64 18 的输出
WEBUI_PASSWORD=
# WebUI 映射到服务器本机的端口
WEBUI_PORT=8080

# 以下几项也能在 WebUI 里修改；在 WebUI 保存过之后，以 data/settings.json 为准
# 每轮间隔（Go duration 格式：90m、6h、12h），最少 10m
INTERVAL=6h
# 每轮额外随机等待 0~JITTER，避免时间过于规律
JITTER=30m
# 心跳上报用的视频，每轮随机选一个，多个用逗号分隔。任意公开视频即可
BVIDS=BV15HFVz1EvM
# 每轮发一条动态再删掉。只发心跳不生效时再打开，会短暂出现在粉丝动态里
DO_DYNAMIC=false
# 动态的文字，可以留空。图片在 WebUI 的设置页上传
DYNAMIC_TEXT=
# 所有 B 站请求经过的代理，留空表示直连（服务器上一般不需要）
PROXY=
# 日志级别：debug（含每个 B 站请求）、info、warn、error
LOG_LEVEL=info

# 日志时区
TZ=Asia/Shanghai
